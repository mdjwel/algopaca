# ==============================================================================
# AlgoPaca Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your keys:
#   cp .env.example .env
#
# IMPORTANT: Never commit your real .env file or API keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Alpaca Paper Trading Credentials (Default Environment)
# ------------------------------------------------------------------------------
# Get your free paper trading API keys at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER=true

# ------------------------------------------------------------------------------
# 2. Alpaca Live Trading Credentials (Optional - Real Money)
# ------------------------------------------------------------------------------
# SAFETY NOTICE: Live trading requires setting ALPACA_ALLOW_LIVE=true explicitly.
# Never reuse your paper API keys for live trading.
# Get live keys at: https://app.alpaca.markets/dashboard/overview
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_ALLOW_LIVE=false

# ------------------------------------------------------------------------------
# 3. AI Providers & Model Configuration (Required for AI Strategy Engine)
# ------------------------------------------------------------------------------
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Active AI provider: openai | gemini
AI_PROVIDER=openai

# ------------------------------------------------------------------------------
# 4. Trading Strategy & Watchlist Defaults
# ------------------------------------------------------------------------------
# Strategy Mode: sma | dip | pair | ls | ai
STRATEGY_MODE=sma

# Watchlist: comma-separated ticker symbols
SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ

# Bar Timeframe (e.g., 1Min, 5Min, 15Min, 1Hour, 1Day)
BAR_TIMEFRAME=15Min

# Polling Interval (seconds between strategy cycles, minimum 10)
POLL_SECONDS=20

# Order Sizing: qty (shares) | notional ($ amount) | ai (model-sized)
SIZE_MODE=qty
TRADE_QTY=1.0
TRADE_NOTIONAL=100.0

# ------------------------------------------------------------------------------
# 5. Engine Presets
# ------------------------------------------------------------------------------
# SMA Presets: classic (10/30) | short_term (5/20) | fibonacci (8/21) | swing (20/50) | golden_cross (50/200) | custom
SMA_PRESET=classic
FAST_SMA=10
SLOW_SMA=30

# Dip Presets: deep | mild | washout | custom
DIP_PRESET=deep
DIP_RSI_BUY=30.0
DIP_RSI_SELL=65.0
DIP_SKIP_BEARISH=true

# Pair Presets: qld_qurl | tqqq_sqqq | custom
PAIR_PRESET=qld_qurl
PAIR_LONG_SYMBOL=QLD
PAIR_SHORT_SYMBOL=QURL
PAIR_SMA_PERIOD=50
PAIR_LOOKBACK=7
PAIR_IMPULSE_PCT=-5.0
PAIR_WEAK_SIDE=long

# Regime Dual Momentum (L/S) Settings
LS_EMA_FAST=8
LS_EMA_SLOW=21
LS_ADX_MIN=15.0
LS_ATR_STOP_MULT=2.0
LS_RISK_PCT=1.0
LS_RR=2.0
LS_TIME_STOP_BARS=20

# AI Strategy Presets: balanced | conservative | momentum | mean_reversion | news_aware | trend_atr | pead | orb | custom
AI_PRESET=balanced
AI_INSTRUCTIONS=Focus on high-liquidity names with clear trend structure and favorable risk-to-reward.
AI_MIN_CONFIDENCE=0.55

# ------------------------------------------------------------------------------
# 6. Risk Engine & Execution Guardrails
# ------------------------------------------------------------------------------
AI_RISK_PCT=0.5             # Equity % risked per trade (0 = fixed qty/notional)
AI_ATR_STOP_MULT=1.8        # Stop distance in ATR14
AI_TAKE_PROFIT_R=2.0        # Profit target at N x initial risk (0 = let it run)
AI_TRAIL_AFTER_R=1.0        # Trail stop after reaching N x initial risk
AI_MAX_POSITIONS=3          # Maximum concurrent open positions (0 = unlimited)
AI_DAILY_LOSS_LIMIT_PCT=3.0 # Halt new entries if day P&L drops below -N%
AI_MIN_HOLD_MINUTES=15      # Minimum minutes to hold before AI flip/exit (stops still execute)
AI_COOLDOWN_MINUTES=60      # Cooldown before re-entering a ticker after stop-out
AI_MAX_SPREAD_BPS=25        # Skip entries if bid-ask spread exceeds N basis points
AI_REVERSAL_CONF_BUMP=0.15  # Extra confidence required to flip existing position
AI_REQUEST_TIMEOUT=60       # Maximum seconds per AI provider request
STOP_LOSS_PCT=0             # Fallback percentage stop loss (0 = disabled)
STOP_LIMIT_OFFSET_PCT=0     # Offset for stop-limit orders

# ------------------------------------------------------------------------------
# 7. UI & Localization
# ------------------------------------------------------------------------------
# Language: en (English) | bn (Bangla) | es (Spanish) | fr (French) | hi (Hindi)
LANG_CODE=en

# ------------------------------------------------------------------------------
# 8. Options overlay (every strategy)
# ------------------------------------------------------------------------------
# Maps each SMA / dip / pair / LS / AI cycle onto Alpaca options.
# vertical = defined-risk debit spread (default)
# long_option = long ATM call (longs) or put (shorts)
# hedge = protective put/call, plus a covered call when shares >= 100
OPTIONS_ENABLED=true
OPTIONS_STYLE=vertical
OPTIONS_DTE_MIN=21
OPTIONS_DTE_MAX=45
OPTIONS_OTM_PCT=5.0
OPTIONS_MAX_CONTRACTS=1
OPTIONS_MAX_PREMIUM_PCT=1.0

# ------------------------------------------------------------------------------
# 9. Web Server
# ------------------------------------------------------------------------------
ALGOPACA_HOST=127.0.0.1
ALGOPACA_PORT=8765

